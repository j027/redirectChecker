{
  "name": "discordbot",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start:dev": "tsx src/discordBot.ts",
    "start": "node dist/discordBot.js",
    "deploy:dev": "tsx src/deployCommands.ts",
    "deploy": "node dist/deployCommands.js",
    "init-db:dev": "tsx src/initDb.ts",
    "init-db": "node dist/initDb.js",
    "clean": "rm -rf dist",
    "prebuild": "yarn clean",
    "test": "vitest"
  },
  "dependencies": {
    "@google-cloud/web-risk": "^5.3.1",
    "discord.js": "^14.26.2",
    "dotenv": "^17.4.1",
    "nodemailer": "^8.0.5",
    "onnxruntime-node": "1.24.3",
    "patchright": "^1.59.4",
    "pg": "^8.20.0",
    "protobufjs": "^8.0.1",
    "sharp": "^0.34.5",
    "tldts": "^7.0.28",
    "undici": "^8.0.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "packageManager": "yarn@4.13.0"
}
