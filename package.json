{
  "name": "discordbot",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start:dev": "tsx src/discordBot.ts",
    "start": "node dist/discordBot.js",
    "init-db:dev": "tsx src/initDb.ts",
    "init-db": "node dist/initDb.js",
    "reset-training-data:dev": "tsx src/resetTrainingDataset.ts",
    "reset-training-data": "node dist/resetTrainingDataset.js",
    "clean": "rm -rf dist",
    "prebuild": "yarn clean",
    "test": "vitest"
  },
  "dependencies": {
    "@google-cloud/web-risk": "^6.1.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "nodemailer": "^9.1.1",
    "onnxruntime-node": "1.30.0",
    "patchright": "1.63.0",
    "pg": "^8.23.1",
    "protobufjs": "^8.8.0",
    "sharp": "^0.35.5",
    "tldts": "^7.4.16",
    "tlsh": "^1.0.8",
    "undici": "^8.11.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "yarn@4.18.0"
}
