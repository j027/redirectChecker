{
  "name": "discordbot",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start:dev": "tsx src/discordBot.ts",
    "start": "node dist/discordBot.js",
    "deploy:dev": "tsx src/deployCommands.ts",
    "deploy": "node dist/deployCommands.js",
    "init-db:dev": "tsx src/initDb.ts",
    "init-db": "node dist/initDb.js",
    "clean": "rm -rf dist",
    "prebuild": "yarn clean",
    "test": "vitest"
  },
  "dependencies": {
    "@google-cloud/web-risk": "^5.3.1",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "onnxruntime-node": "1.24.3",
    "patchright": "^1.58.2",
    "pg": "^8.20.0",
    "protobufjs": "^8.0.1",
    "sharp": "^0.34.5",
    "tldts": "^7.0.24",
    "undici": "^7.22.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.11.2",
    "@types/pg": "^8.18.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "yarn@4.12.0"
}
